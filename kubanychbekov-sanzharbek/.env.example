# Copy to .env (never commit .env). All values below are demo-only.
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=fixflow
POSTGRES_DB=fixflow
API_PORT=8000
WEB_PORT=3000
SECRET_KEY=dev-only-change-me
CORS_ORIGINS=http://localhost:3000
# For running the backend outside Docker (tests, alembic):
DATABASE_URL=postgresql+psycopg://fixflow:fixflow@localhost:5432/fixflow
TEST_DATABASE_URL=postgresql+psycopg://fixflow:fixflow@localhost:5432/fixflow_test
